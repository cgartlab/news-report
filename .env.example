# news-report 环境变量配置
# 复制为 .env 并填入真实值：cp .env.example .env

# ─── LLM API Keys ───────────────────────────────────────────
# 脚本链路评估阶段使用，至少设置一个；不设则仅用规则评估（等价 --skip-llm）
# 优先级：SenseNova（最快）→ MiniMax → SiliconFlow → DeepSeek
SENSENOVA_API_KEY=
MINIMAX_API_KEY=
SILICONFLOW_API_KEY=
DEEPSEEK_API_KEY=

# ─── Search ──────────────────────────────────────────────────
# SearXNG 实例地址（不设则默认 http://localhost:8099）
SEARXNG_URL=http://localhost:8099

# ─── Telegram ────────────────────────────────────────────────
# telegram-history skill 的 tg_history.py 脚本路径
# 不设则跳过 Telegram 采集
TG_HISTORY_SCRIPT=
