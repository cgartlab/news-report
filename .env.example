# news-report 环境变量配置
# 复制为 .env 并填入真实值：cp .env.example .env

# ─── LLM API Keys ───────────────────────────────────────────
# 脚本链路评估阶段使用，至少设置一个；不设则仅用规则评估（等价 --skip-llm）
# 优先级：SenseNova（最快）→ MiniMax → SiliconFlow → DeepSeek
SENSENOVA_API_KEY=
MINIMAX_API_KEY=
SILICONFLOW_API_KEY=
DEEPSEEK_API_KEY=

# ─── Search ──────────────────────────────────────────────────
# SearXNG 实例地址（不设则默认 http://localhost:8099）
SEARXNG_URL=http://localhost:8099

# ─── Zhihu Search CLI ────────────────────────────────────────────────────
# zhihu-search 二进制路径（自动检测时可不设，默认 ~/.local/bin/zhihu-search）
# ZHIHU_SEARCH_CLI_PATH=/root/.local/bin/zhihu-search
# 兼容旧 zhihu-cli 环境变量的别名（自动查找时会尝试）
# ZHIHU_CLI_PATH=
# Access Secret（也可通过 `zhihu-search --save-token` 写入凭证文件）
ZHIHU_ACCESS_SECRET=

# ─── Twitter CLI ─────────────────────────────────────────────
# Twitter CLI 二进制路径（自动检测时可不设）
# TWITTER_CLI_PATH=C:/Users/cgart/.local/bin/twitter
# 鉴权令牌（可选，替代浏览器 Cookie）
# TWITTER_AUTH_TOKEN=
# TWITTER_CT0=

# ─── Bilibili CLI ────────────────────────────────────────────
# Bilibili CLI 二进制路径（自动检测时可不设）
# BILIBILI_CLI_PATH=C:/Users/cgart/.local/bin/bili

# ─── Xiaohongshu CLI ─────────────────────────────────────────
# 小红书 CLI 二进制路径（自动检测时可不设）
# XHS_CLI_PATH=C:/Users/cgart/.local/bin/xhs

# ─── Telegram ────────────────────────────────────────────────
# telegram-history skill 的 tg_history.py 脚本路径
# 不设则跳过 Telegram 采集
TG_HISTORY_SCRIPT=
